@implements IDisposable
@inject PositionTracker Tracker
@inject PositionServer Server
@inject WorldStateTracker World
@inject SettingsStore Settings
@inject Localizer L
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <section class="sv-panel">
        <div class="sv-status-row">
            <p class="sv-eyebrow sv-status-@StatusTone"><span></span>@StatusText</p>
            @if (ShowDiagnostics && Tracker.ProcessId is int pid)
            {
                <span class="sv-meta">PID @pid · base 0x@(Tracker.ModuleBase.ToString("X"))</span>
            }
        </div>
        @if (ShowDiagnostics)
        {
            @if (Tracker.PawnClass is { } pawn && Tracker.Status == TrackerStatus.Attached)
            {
                <p class="sv-copy">Tracking <span class="sv-highlight">@pawn</span></p>
            }
            else if (!string.IsNullOrEmpty(Tracker.Message))
            {
                <p class="sv-copy">@Tracker.Message</p>
            }
            @if (Tracker.EngineSummary is { } summary)
            {
                <p class="sv-meta">@summary</p>
            }
            @if (Server.Port is int port)
            {
                <p class="sv-meta">Map server ws://localhost:@port · @Server.ClientCount connected</p>
            }
        }
        @* Shown in every build: finding doors and items takes a minute, and the map is incomplete until then. *@
        <p class="sv-copy">@WorldStatusText</p>
        @* Shown in every build: without the server the map can't receive positions. *@
        @if (Server.Error is { } serverError)
        {
            <p class="sv-copy sv-error">@serverError(T)</p>
        }
    </section>

    <div class="sv-coords">
        @foreach (var (axis, value) in Axes)
        {
            <section class="sv-panel sv-coord">
                <span class="sv-label">@axis</span>
                <span class="sv-value"><bdi dir="ltr">@(value is double d ? L.Number(d / 100, "N2") : "—")</bdi></span>
            </section>
        }
        <section class="sv-panel sv-coord">
            <span class="sv-label">@T.Heading</span>
            <span class="sv-value"><bdi dir="ltr">@(Tracker.Position?.Yaw is double yaw ? $"{L.Number(yaw)}°" : "—")</bdi></span>
        </section>
    </div>

    <MudExpansionPanels Outlined="true" Elevation="0" Class="sv-settings">
        <MudExpansionPanel Text="@T.MapTitle">
            <MudStack Spacing="2">
                <MudStack Row="true">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenMapInBrowser">@T.OpenMapInBrowser</MudButton>
                </MudStack>
                <span class="sv-label sv-control-group">@T.OverlaySection</span>
                <MudSwitch T="bool" Value="Settings.Current.OverlayEnabled" ValueChanged="@(on => Settings.Update(s => s.OverlayEnabled = on))"
                           Color="Color.Primary" Label="@T.OverlayShow" />
                <MudSelect T="OverlayCorner" Value="Settings.Current.OverlayCorner" ValueChanged="@(corner => Settings.Update(s => s.OverlayCorner = corner))"
                           ToStringFunc="CornerName" Label="@T.OverlayCorner" Variant="Variant.Outlined">
                    @foreach (var corner in Enum.GetValues<OverlayCorner>())
                    {
                        <MudSelectItem T="OverlayCorner" Value="corner">@CornerName(corner)</MudSelectItem>
                    }
                </MudSelect>
                <MudSlider T="int" Value="Settings.Current.OverlaySize" ValueChanged="@(size => Settings.Update(s => s.OverlaySize = size))"
                           Min="240" Max="800" Step="20" Immediate="false" Color="Color.Primary">@T.OverlaySize: @L.Number(Settings.Current.OverlaySize)</MudSlider>
                <MudSlider T="int" Value="Settings.Current.OverlayOpacity" ValueChanged="@(opacity => Settings.Update(s => s.OverlayOpacity = opacity))"
                           Min="30" Max="100" Step="5" Immediate="false" Color="Color.Primary">@T.OverlayOpacity: @L.Number(Settings.Current.OverlayOpacity)</MudSlider>
                <span class="sv-label">@T.OverlayHotkeys</span>
                <dl class="sv-hotkeys">
                    @foreach (var (keys, action) in Hotkeys)
                    {
                        <dt><bdi dir="ltr">@keys</bdi></dt>
                        <dd>@action</dd>
                    }
                </dl>
            </MudStack>
        </MudExpansionPanel>
        <MudExpansionPanel Text="@T.Settings">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(T.SavedTo, Localizer.Isolated(Settings.FilePath))</MudText>
                <MudSelect T="string" Value="_language" ValueChanged="OnLanguageSelected" ToStringFunc="LanguageName" Label="@T.Language" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@AutomaticLanguage">@T.LanguageAutomatic</MudSelectItem>
                    @foreach (var language in Localizer.Languages)
                    {
                        <MudSelectItem T="string" Value="@language.Code">@language.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_processNames" Label="@T.ProcessNames" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_pollIntervalMs" Label="@T.PollInterval" Min="10" Max="2000" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_gameCheckIntervalSeconds" Label="@T.GameCheckInterval" Min="1" Max="300" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_webSocketPort" Label="@T.MapPort" Min="1024" Max="65535" Variant="Variant.Outlined"
                                 HelperText="@T.MapPortHelp" />
                <MudSwitch @bind-Value="_minimizeToTray" Color="Color.Primary" Label="@T.MinimizeToTray" />
                <MudSwitch @bind-Value="_startMinimized" Color="Color.Primary" Label="@T.StartMinimized" />
                <MudSwitch @bind-Value="_useManual" Color="Color.Primary"
                           Label="@T.UseManualChain" />
                @if (_useManual)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @string.Format(T.ManualChainHelp, Localizer.Isolated("[[game.exe + base] + offset1] + ... + last offset"))
                    </MudText>
                    <MudTextField @bind-Value="_baseOffset" Label="@T.BaseOffset" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_offsets" Label="@T.Offsets" Variant="Variant.Outlined"
                                  HelperText="@string.Format(T.OffsetsExample, Localizer.Isolated("0x30, 0x2A0, 0x1A0, 0x128"))" />
                }
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@T.Save</MudButton>
                </MudStack>
            </MudStack>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>

@code {
    // Process, pawn and engine details are for development; release builds show only the status.
#if DEBUG
    private static readonly bool ShowDiagnostics = true;
#else
    private static readonly bool ShowDiagnostics = false;
#endif

    private const string AutomaticLanguage = "";

    private string _language = AutomaticLanguage;
    private string _processNames = "";
    private string _baseOffset = "";
    private string _offsets = "";
    private int _pollIntervalMs;
    private int _gameCheckIntervalSeconds;
    private bool _minimizeToTray;
    private bool _startMinimized;
    private bool _useManual;
    private int _webSocketPort;

    private Strings T => L.T;

    private (string Keys, string Action)[] Hotkeys =>
    [
        ("Ctrl+Alt+F5", T.HotkeyToggle),
        ("Ctrl+Alt+F6", T.HotkeyZoomIn),
        ("Ctrl+Alt+F7", T.HotkeyZoomOut),
        ("Ctrl+Alt+F8", T.HotkeyFollow),
        ("Ctrl+Alt+F9", T.HotkeyInteract),
    ];

    private string CornerName(OverlayCorner corner) => corner switch
    {
        OverlayCorner.TopLeft => T.CornerTopLeft,
        OverlayCorner.TopRight => T.CornerTopRight,
        OverlayCorner.BottomLeft => T.CornerBottomLeft,
        _ => T.CornerBottomRight,
    };

    private (string Axis, double? Value)[] Axes =>
    [
        ("X", Tracker.Position?.X),
        ("Y", Tracker.Position?.Y),
        ("Z", Tracker.Position?.Z),
    ];

    // Picks the status dot color in app.css.
    private string StatusTone => Tracker.Status switch
    {
        TrackerStatus.Attached => "ok",
        TrackerStatus.WaitingForGame or TrackerStatus.PointerInvalid => "warn",
        TrackerStatus.Locating => "info",
        TrackerStatus.Error => "error",
        _ => "idle",
    };

    private string WorldStatusText => World.Message?.Invoke(T) ?? string.Format(T.WorldLoaded,
        L.Number(World.Doors.Count), Count(World.Doors, ObjectState.Locked),
        L.Number(World.Spawns.Count), Count(World.Spawns, ObjectState.Collected),
        L.Number(World.Stashes.Count), Count(World.Stashes, ObjectState.Marked), Count(World.Stashes, ObjectState.Looted));

    private string Count(IReadOnlyDictionary<string, ObjectState> states, ObjectState flag) =>
        L.Number(states.Values.Count(s => s.HasFlag(flag)));

    private string StatusText => Tracker.Status switch
    {
        TrackerStatus.Attached => T.StatusTracking,
        TrackerStatus.WaitingForGame => T.StatusWaitingForGame,
        TrackerStatus.Locating => T.StatusLocating,
        TrackerStatus.PointerInvalid => T.StatusNoPlayer,
        TrackerStatus.Error => T.StatusError,
        _ => T.StatusStarting,
    };

    protected override void OnInitialized()
    {
        var s = Settings.Current;
        _language = s.Language ?? AutomaticLanguage;
        _processNames = string.Join(", ", s.ProcessNames);
        _baseOffset = s.BaseOffset;
        _offsets = string.Join(", ", s.Offsets);
        _pollIntervalMs = s.PollIntervalMs;
        _gameCheckIntervalSeconds = s.GameCheckIntervalSeconds;
        _minimizeToTray = s.MinimizeToTray;
        _startMinimized = s.StartMinimized;
        _useManual = s.UseManualPointerChain;
        _webSocketPort = s.WebSocketPort;
        Tracker.Changed += OnStateChanged;
        Server.Changed += OnStateChanged;
        World.Changed += OnStateChanged;
        L.Changed += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OpenMapInBrowser() =>
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(
            MapSite.BrowserUrl(Settings.Current.WebSocketPort, L.Code)) { UseShellExecute = true });

    private string LanguageName(string code) =>
        Localizer.Languages.FirstOrDefault(l => l.Code == code)?.Name ?? T.LanguageAutomatic;

    private void OnLanguageSelected(string code)
    {
        _language = code;
        Settings.Update(s => s.Language = code == AutomaticLanguage ? null : code);
    }

    private async Task SaveAsync()
    {
        var offsets = Split(_offsets);
        var invalid = offsets.Prepend(_baseOffset).FirstOrDefault(o => !TrackerSettings.TryParseHex(o, out _));
        if (invalid is not null)
        {
            Snackbar.Add(string.Format(T.InvalidHex, invalid), Severity.Error);
            return;
        }

        Settings.Update(s =>
        {
            s.ProcessNames = Split(_processNames);
            s.UseManualPointerChain = _useManual;
            s.BaseOffset = _baseOffset.Trim();
            s.Offsets = offsets;
            s.PollIntervalMs = _pollIntervalMs;
            s.GameCheckIntervalSeconds = _gameCheckIntervalSeconds;
            s.MinimizeToTray = _minimizeToTray;
            s.StartMinimized = _startMinimized;
            s.WebSocketPort = _webSocketPort;
        });

        // Restart so a new mode, interval or process name takes effect. (The map server
        // restarts itself if the port changed.)
        await Tracker.RestartAsync();
        Snackbar.Add(T.SettingsSaved, Severity.Success);
    }

    private static List<string> Split(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    public void Dispose()
    {
        Tracker.Changed -= OnStateChanged;
        Server.Changed -= OnStateChanged;
        World.Changed -= OnStateChanged;
        L.Changed -= OnStateChanged;
    }
}
