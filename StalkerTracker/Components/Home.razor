@implements IDisposable
@inject PositionTracker Tracker
@inject SettingsStore Settings
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudChip T="string" Color="@StatusColor" Variant="Variant.Filled" Size="Size.Small">@StatusText</MudChip>
                @if (Tracker.ProcessId is int pid)
                {
                    <MudText Typo="Typo.caption">PID @pid · base 0x@(Tracker.ModuleBase.ToString("X"))</MudText>
                }
            </MudStack>
            @if (Tracker.IsRunning)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopAsync">Stop</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Tracker.Start">Start tracking</MudButton>
            }
        </MudStack>
        @if (!string.IsNullOrEmpty(Tracker.Message))
        {
            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">@Tracker.Message</MudText>
        }
    </MudPaper>

    <MudGrid Spacing="3">
        @foreach (var (axis, value) in Axes)
        {
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.overline">@axis</MudText>
                    <MudText Typo="Typo.h4" Style="font-variant-numeric: tabular-nums;">
                        @(value is double d ? (d / 100).ToString("N2") : "—")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(value is double c ? $"{c:N1} UU (cm)" : "meters")
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudExpansionPanels>
        <MudExpansionPanel Text="Pointer settings">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Cheat Engine style chain: [[game.exe + base] + offset1] + ... + last offset → player location (3 doubles).
                    Saved to @Settings.FilePath
                </MudText>
                <MudTextField @bind-Value="_processNames" Label="Process names (comma separated, no .exe)" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_baseOffset" Label="Base offset (hex)" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_offsets" Label="Offsets (hex, comma separated)" Variant="Variant.Outlined"
                              HelperText="Example: 0x30, 0x2A0, 0x1A0, 0x128" />
                <MudNumericField @bind-Value="_pollIntervalMs" Label="Poll interval (ms)" Min="10" Max="2000" Variant="Variant.Outlined" />
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
                </MudStack>
            </MudStack>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>

@code {
    private string _processNames = "";
    private string _baseOffset = "";
    private string _offsets = "";
    private int _pollIntervalMs;

    private (string Axis, double? Value)[] Axes =>
    [
        ("X", Tracker.Position?.X),
        ("Y", Tracker.Position?.Y),
        ("Z", Tracker.Position?.Z),
    ];

    private Color StatusColor => Tracker.Status switch
    {
        TrackerStatus.Attached => Color.Success,
        TrackerStatus.WaitingForGame or TrackerStatus.PointerInvalid => Color.Warning,
        TrackerStatus.Error => Color.Error,
        _ => Color.Default,
    };

    private string StatusText => Tracker.Status switch
    {
        TrackerStatus.Attached => "Tracking",
        TrackerStatus.WaitingForGame => "Waiting for game",
        TrackerStatus.PointerInvalid => "No player",
        TrackerStatus.Error => "Error",
        _ => "Stopped",
    };

    protected override void OnInitialized()
    {
        var s = Settings.Current;
        _processNames = string.Join(", ", s.ProcessNames);
        _baseOffset = s.BaseOffset;
        _offsets = string.Join(", ", s.Offsets);
        _pollIntervalMs = s.PollIntervalMs;
        Tracker.Changed += OnTrackerChanged;
    }

    private void OnTrackerChanged() => InvokeAsync(StateHasChanged);

    private Task StopAsync() => Tracker.StopAsync();

    private async Task SaveAsync()
    {
        var offsets = Split(_offsets);
        var invalid = offsets.Prepend(_baseOffset).FirstOrDefault(o => !TrackerSettings.TryParseHex(o, out _));
        if (invalid is not null)
        {
            Snackbar.Add($"'{invalid}' is not a valid hex value.", Severity.Error);
            return;
        }

        Settings.Save(new TrackerSettings
        {
            ProcessNames = Split(_processNames),
            BaseOffset = _baseOffset.Trim(),
            Offsets = offsets,
            PollIntervalMs = _pollIntervalMs,
        });

        // Restart so a new poll interval or process name takes effect.
        if (Tracker.IsRunning)
        {
            await Tracker.StopAsync();
            Tracker.Start();
        }
        Snackbar.Add("Settings saved.", Severity.Success);
    }

    private static List<string> Split(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    public void Dispose() => Tracker.Changed -= OnTrackerChanged;
}
