<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versioned Windows TFM pulls in Microsoft.Windows.SDK.NET, which WebView2's WPF control needs at runtime. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>StalkerTracker</RootNamespace>
    <!-- The game is 64-bit; reading its pointers needs a 64-bit process. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

</Project>
